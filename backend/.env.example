# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5175

# JWT Configuration
